{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/_next/static/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/(.*).(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|json)",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "public, max-age=2592000"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    }
  ]
}
